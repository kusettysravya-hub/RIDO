{
  "name": "realtime-ride-sharing-fleet-management",
  "version": "1.0.0",
  "description": "RIDO - Smart Rides. Seamless Journeys. Real-Time Ride Sharing & Fleet Management System (BTech CSE Engineering Project)",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && python run.py",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently -n \"BACKEND,CLIENT\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:client\"",
    "build:client": "cd client && npm run build",
    "test:backend": "cd backend && python tests/test_api.py",
    "seed:backend": "cd backend && python -m app.seed_data"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
